        reservation_id = cursor.lastrowid
        conn.close()

        return success_response({"reservation_id": reservation_id}, "预约成功")

    except sqlite3.OperationalError as e:
        conn.rollback()
        conn.close()
        return error_response("系统繁忙，请稍后重试", 503)
