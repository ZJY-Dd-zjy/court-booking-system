        </div>
        <h1>🔧 管理员 - 全局优化</h1>

        <button class="optimize-btn" id="optimizeBtn" onclick="doOptimize()">
            ⚡ 执行全局优化
        </button>

        <div class="result-area" id="resultArea">
            <div class="empty">点击上方按钮执行全局场地分配优化</div>
        </div>
    </div>

    <script>
        var token = localStorage.getItem("token");
        var userId = localStorage.getItem("user_id");
        var API_BASE = window.location.origin;

        // 检查是否登录
        if (!token) {
            document.getElementById('optimizeBtn').textContent = '请先登录后再执行优化';
            document.getElementById('optimizeBtn').disabled = true;
        }

        function doOptimize() {
            var btn = document.getElementById('optimizeBtn');
            var area = document.getElementById('resultArea');

            btn.disabled = true;
            btn.textContent = '计算中...';
            area.innerHTML = '<div class="loading">正在计算最优分配方案，请稍候...</div>';

            // D18: 同时获取真实场地 + 真实用户（从数据库）
            Promise.all([
                fetch(API_BASE + '/api/courts').then(function(r){ return r.json(); }),
                fetch(API_BASE + '/api/users', { headers: {'Authorization': token} }).then(function(r){ return r.json(); })
            ]).then(function(results) {
                var courts = results[0].data || results[0];
                var users  = results[1].data || results[1];


第9页
                if (users.length === 0) {
                    btn.disabled = false;
                    btn.textContent = '⚡ 执行全局优化';
                    area.innerHTML = '<div class="error">数据库中没有普通用户，无法优化</div>';
                    return;
                }

                // 建立 ID→对象 映射，渲染时用真实名称
                window._courtsMap = {};
                for (var i = 0; i < courts.length; i++) {
                    window._courtsMap[courts[i].id] = courts[i];
                }
                window._usersMap = {};
                for (var i = 0; i < users.length; i++) {
                    window._usersMap[users[i].id] = users[i];
                }

                // 调优化接口（传入真实数据）
                return fetch(API_BASE + '/api/optimize', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'Authorization': token},
                    body: JSON.stringify({ courts: courts, users: users })
                });
            }).then(function(r) {
                if (!r) return;  // 前面已处理错误
                return r.json();
            }).then(function(data) {
                btn.disabled = false;
                btn.textContent = '⚡ 执行全局优化';

                if (!data || !data.success) {
                    area.innerHTML = '<div class="error">优化失败：' + (data && (data.msg || data.data && data.data.msg) ? (data.msg || data.data && data.data.msg) : '未知错误') + '</div>';
                    return;
                }

                var resultData = data.data || data;
                renderPlan(resultData.plan, resultData.match_rate, resultData.runtime_seconds, resultData.actual_match_rate, resultData.actual_matched, resultData.actual_total, resultData.total_iterations, resultData.msg);
            }).catch(function(err) {
                btn.disabled = false;
                btn.textContent = '⚡ 执行全局优化';
                area.innerHTML = '<div class="error">请求失败：' + err.message + '</div>';
            });
        }

        function renderPlan(plan, matchRate, runtime, actualMatchRate, actualMatched, actualTotal, totalIterations, msg) {
            var area = document.getElementById('resultArea');
            if (!plan || plan.length === 0) {
                if (msg) {
                    area.innerHTML = '<div class="error">' + msg + '</div>';
                } else {

第10页
                    area.innerHTML = '<div class="empty">暂无分配结果</div>';
                }
                return;
            }

            // 统计
            var perfect = 0, good = 0, poor = 0;
            for (var i = 0; i < plan.length; i++) {
                var s = plan[i].score;
                if (s >= 1.0) perfect++;
                else if (s >= 0.5) good++;
                else poor++;
            }

            var matchRateText = matchRate ? (matchRate * 100).toFixed(1) : '0';
            var runtimeText   = runtime   ? runtime.toFixed(2) : '0';
            var actualMatchRateText = (actualMatchRate !== undefined) ? (actualMatchRate * 100).toFixed(1) : '--';
            var actualDetail = (actualMatched !== undefined && actualTotal !== undefined)
                ? '（' + actualMatched + '/' + actualTotal + '）' : '';

            var html = '';
            html += '<div class="result-title">📊 优化结果</div>';
            var iterText = (totalIterations !== undefined) ? totalIterations.toLocaleString() : "--";
            html += '<div class="summary-line">算法匹配率 <b>' + matchRateText + '%</b>　|　计算耗时 <b>' + runtimeText + '秒</b>　|　迭代次数 <b>' + iterText + '</b></div>';
            html += '<div class="summary-line" style="background:#f6ffed;">用户真实匹配率 <b>' + actualMatchRateText + '%</b> ' + actualDetail + '　—　基于历史预约统计</div>';
            html += '<div class="stats-bar">';
            html += '<div class="stats-item"><div class="number">' + plan.length + '</div><div class="label">总分配数</div></div>';
            html += '<div class="stats-item"><div class="number">' + perfect + '</div><div class="label">完美匹配</div></div>';
            html += '<div class="stats-item"><div class="number">' + good + '</div><div class="label">一般匹配</div></div>';
            html += '</div>';

            html += '<div class="plan-grid">';
            for (var i = 0; i < plan.length; i++) {
                var p = plan[i];
                var matchClass = 'match-poor';
                var matchText = '一般';
                if (p.score >= 1.0) { matchClass = 'match-perfect'; matchText = '完美匹配'; }
                else if (p.score >= 0.5) { matchClass = 'match-good'; matchText = '偏好匹配'; }

                // 用真实名称替换 ID
                var user = window._usersMap[p.user_id];
                var court = window._courtsMap[p.court_id];
                var userName = user ? user.username : ('用户 #' + p.user_id);
                var courtName = court ? (court.name + '（' + court.type + '）') : ('场地 #' + p.court_id);

                html += '<div class="plan-card ' + matchClass + '">';
                html += '<div class="user-name">' + userName + '</div>';
                html += '<div class="court-name">→ ' + courtName + '</div>';
                if (p.start_time && p.end_time) {
                    html += '<div class="time-slot">🕐 ' + p.start_time + ' - ' + p.end_time + '</div>';

第11页
                }
                html += '<span class="score-badge">' + matchText + '</span>';
                html += '</div>';
            }
            html += '</div>';

            area.innerHTML = html;
        }
    </script>
</body>
